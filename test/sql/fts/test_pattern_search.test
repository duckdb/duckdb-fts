d1

# Non-layered indexes do not pay for pattern dictionary sidecars.
statement ok
CREATE TABLE plain_pattern_docs(id INTEGER, body VARCHAR)

statement ok
INSERT INTO plain_pattern_docs VALUES (1, 'database')

statement ok
PRAGMA create_fts_index(
    'plain_pattern_docs',
    'id',
    'body',
    stemmer='none',
    stopwords='none'
)

query I
SELECT count(*)
FROM information_schema.tables
WHERE table_schema = 'fts_main_plain_pattern_docs'
  AND table_name = 'raw_term_grams'
----
0
