query II
SELECT n, fts_main_shared_docs.highlight(t,q,'[',']',query_mode:=m)
FROM (VALUES (1,'alpha beta','alpha the beta','phrase'),
             (2,'alpha the beta','alpha the beta','phrase'),
             (3,'alpha inside','alpha in','phrase_prefix'),
             (4,'machine running','machine runs','phrase_prefix'),
             (5,'alpha beta','alpha b','autocomplete'),
             (6,'alpha beta',NULL,'phrase'),
             (7,NULL,'alpha','standard'),
             (8,'alpha beta','alpha alpha','near')) v(n,t,q,m)
ORDER BY n
----
1	alpha beta
2	[alpha the beta]
3	[alpha inside]
4	machine running
5	[alpha] beta
6	alpha beta
7	NULL
8	[alpha] beta

endloop

endloop

# Repeated slots must each be filled in the same occurrence, including overlaps.
query I
SELECT fts_main_shared_docs.highlight('alpha alpha alpha beta', 'alpha alpha beta', '[', ']', query_mode:='phrase')
----
alpha [alpha alpha beta]

query I
SELECT fts_main_shared_docs.highlight('alpha beta alpha beta', 'alpha alpha beta', '[', ']', query_mode:='phrase')
----
alpha beta alpha beta

query I
SELECT fts_main_shared_docs.highlight('alpha beta alpha beta alpha', 'alpha the alpha', '[', ']', query_mode:='phrase')
----
[alpha beta alpha beta alpha]

query I
SELECT fts_main_shared_docs.highlight('running runs running', 'runs running', '[', ']', query_mode:='phrase_prefix')
----
running [runs running]

# A long text with overlapping matches must not need an all-pairs text-token join.
query I
SELECT bool_and(fts_main_shared_docs.highlight(rtrim(repeat('alpha ', n)), 'alpha alpha', '[', ']', query_mode:='phrase')
                = '[' || rtrim(repeat('alpha ', n)) || ']')
FROM (VALUES (2), (3), (5000)) sizes(n)
----
true
