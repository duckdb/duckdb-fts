# name: test/sql/fts/test_shared_query_analysis.test
# description: Search and highlighting share query slots, positions and prefix eligibility
# group: [fts]

require fts

statement ok
CREATE TABLE shared_docs(id VARCHAR, body VARCHAR)

statement ok
INSERT INTO shared_docs VALUES ('a','alpha inside'), ('b','alpha the beta'), ('c','alpha beta'),
    ('d','machine running'), ('e','machine runs'), ('f','the alpha beta'), ('g','running'),
    ('h','placeholder'), ('i','alpha theory'), ('j','android')

foreach stemmer none porter

foreach tokenizer regex opensearch_standard

statement ok
PRAGMA create_fts_index('shared_docs','id','body',stemmer='{stemmer}',stopwords='english',tokenizer='{tokenizer}',layered_search=true,overwrite=true)

query II
SELECT
    (SELECT coalesce(list(docname ORDER BY docname), [])
     FROM fts_main_shared_docs.search_layered_bm25('alpha the beta',query_mode:='phrase',
         enable_prefix:=false,enable_substring:=false,enable_fuzzy:=false,max_df_ratio:=1,max_df:=100000,top_k:=100)),
    (SELECT coalesce(list(id ORDER BY id), []) FROM shared_docs
     WHERE fts_main_shared_docs.highlight(body,'alpha the beta','[',']',query_mode:='phrase') <> body)
----
[b]	[b]

query II
SELECT
    (SELECT coalesce(list(docname ORDER BY docname), [])
     FROM fts_main_shared_docs.search_layered_bm25('alpha beta',query_mode:='phrase',
         enable_prefix:=false,enable_substring:=false,enable_fuzzy:=false,max_df_ratio:=1,max_df:=100000,top_k:=100)),
