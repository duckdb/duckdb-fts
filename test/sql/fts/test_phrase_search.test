# name: test/sql/fts/test_phrase_search.test
# description: Positional phrase and phrase-prefix search
# group: [fts]

require skip_reload

require fts

require json

require no_alternative_verify

statement ok
CREATE TABLE phrase_docs(
    id VARCHAR NOT NULL,
    title VARCHAR,
    body VARCHAR
)

statement ok
INSERT INTO phrase_docs VALUES
    ('p1', 'vector database vector database', 'reference'),
    ('p2', 'vector scalable database', ''),
