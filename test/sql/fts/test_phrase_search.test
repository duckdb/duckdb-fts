# Layered postings store one-based positions independently for each field.
query IIII
SELECT docs.name, dict.term, terms.fieldid, terms.position
FROM fts_main_phrase_docs.terms AS terms
JOIN fts_main_phrase_docs.docs AS docs USING (docid)
JOIN fts_main_phrase_docs.dict AS dict USING (termid)
WHERE docs.name IN ('p1', 'p6')
ORDER BY docs.name, terms.fieldid, terms.position
----
p1	vector	0	1
p1	databas	0	2
p1	vector	0	3
p1	databas	0	4
p1	refer	1	1
p6	vector	0	1
p6	databas	1	1

query T
SELECT data_type
FROM duckdb_columns()
WHERE schema_name = 'fts_main_phrase_docs'
  AND table_name = 'terms'
  AND column_name = 'position'
----
UINTEGER

# Index metadata versions the positional layout and analyzer stream contract.
query IIIIIIIII
SELECT format_version,
       analyzer_version,
       incremental,
       cluster_terms,
       layered_search,
       positions,
       fields = ['title', 'body'],
       length(analyzer_fingerprint),
       analyzer_fingerprint = md5(analyzer_config)
FROM fts_main_phrase_docs.index_metadata
----
4	1	true	true	true	true	true	32	true

