statement ok
CREATE TABLE phrase_rebuild AS SELECT * FROM phrase_docs

statement ok
PRAGMA create_fts_index(
    'phrase_rebuild',
    'id',
    'title',
    'body',
    stemmer='porter',
    stopwords='english',
    layered_search=true
)

query I
SELECT count(*)
FROM (
    (
        SELECT docs.name, dict.term, terms.rawtermid, terms.fieldid, terms.position
        FROM fts_main_phrase_docs.terms AS terms
        JOIN fts_main_phrase_docs.docs AS docs USING (docid)
        JOIN fts_main_phrase_docs.dict AS dict USING (termid)
        EXCEPT ALL
        SELECT docs.name, dict.term, terms.rawtermid, terms.fieldid, terms.position
        FROM fts_main_phrase_rebuild.terms AS terms
        JOIN fts_main_phrase_rebuild.docs AS docs USING (docid)
        JOIN fts_main_phrase_rebuild.dict AS dict USING (termid)
    )
    UNION ALL
    (
        SELECT docs.name, dict.term, terms.rawtermid, terms.fieldid, terms.position
        FROM fts_main_phrase_rebuild.terms AS terms
        JOIN fts_main_phrase_rebuild.docs AS docs USING (docid)
        JOIN fts_main_phrase_rebuild.dict AS dict USING (termid)
        EXCEPT ALL
        SELECT docs.name, dict.term, terms.rawtermid, terms.fieldid, terms.position
        FROM fts_main_phrase_docs.terms AS terms
        JOIN fts_main_phrase_docs.docs AS docs USING (docid)
        JOIN fts_main_phrase_docs.dict AS dict USING (termid)
    )
)
----
0

statement ok
PREPARE rebuild_compare AS
SELECT count(*)
FROM fts_main_phrase_docs.search_layered_bm25($1, query_mode := $2) AS incremental_hits
FULL OUTER JOIN fts_main_phrase_rebuild.search_layered_bm25($1, query_mode := $2) AS rebuilt_hits
  ON incremental_hits.docname = rebuilt_hits.docname
WHERE incremental_hits.docname IS NULL
   OR rebuilt_hits.docname IS NULL
   OR incremental_hits.score IS DISTINCT FROM rebuilt_hits.score
   OR incremental_hits.rank IS DISTINCT FROM rebuilt_hits.rank

query I
EXECUTE rebuild_compare('vector database', 'phrase')
----
0

query I
EXECUTE rebuild_compare('vector datan', 'phrase_prefix')
----
0

